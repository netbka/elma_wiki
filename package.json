{
  "name": "elma-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:explanations:browser": "node tools/solution-explanations-browser-check.mjs",
    "test:config:browser": "node tools/config-acquisition-browser-check.mjs",
    "prod:update": "node tools/prod-update.mjs",
    "test:prod": "python test/prod-update.test.py",
    "agent:context": "node tools/agent-workflow.mjs",
    "check:agent": "node tools/agent-workflow.mjs --check",
    "check:worktrees": "node tools/agent-workflow.mjs --worktrees",
    "test:handoff:browser": "node tools/solution-handoff-browser-check.mjs",
    "test:solution-delivery:browser": "node tools/solution-delivery-browser-check.mjs",
    "test:solution-delivery:storybook": "node tools/solution-delivery-storybook-check.mjs",
    "test:composer:storybook": "node tools/solution-composer-storybook-check.mjs",
    "test:composer:browser": "node tools/composer-build-browser-check.mjs",
    "test:managed:browser": "node tools/managed-workspace-browser-check.mjs",
    "test:comparisons:browser": "node tools/configuration-comparisons-browser-check.mjs",
    "test:change-base:browser": "node tools/change-base-browser-check.mjs",
    "test:merge-resolution:browser": "node tools/merge-resolution-browser-check.mjs",
    "test:delivery:browser": "node tools/delivery-browser-check.mjs",
    "test:delivery:storybook": "node tools/delivery-storybook-check.mjs",
    "test:releases:browser": "node tools/releases-browser-check.mjs",
    "storybook": "npm --prefix storybook run dev",
    "build:storybook": "npm --prefix storybook run build",
    "check:storybook": "node tools/check-flow-catalog.mjs && node --test test/flow-reviews.test.mjs test/flows.test.mjs test/flow-review-api.test.mjs",
    "test:storybook:browser": "node tools/flows-browser-check.mjs",
    "test:flows:keyboard": "node tools/flows-keyboard-check.mjs",
    "build:editor": "node tools/build-editor.mjs",
    "prestart": "npm run build:editor",
    "predev": "npm run build:editor",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "import": "node tools/import.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node verify.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:workspace:browser": "npm run build:editor && node tools/workspace-browser-check.mjs",
    "check:ui-strings": "node tools/ui-strings.mjs",
    "test:internal:browser": "node tools/internal-service-browser-check.mjs"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "monaco-editor": "^0.55.1",
    "nodemailer": "^10.0.15",
    "typescript": "5.9.3",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "yaml": "^2.9.1"
  }
}
