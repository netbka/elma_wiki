PORT=43171
# Optional independent read-only ELMA configuration export service.
CONFIG_SOURCE_API_URL=
CONFIG_SOURCE_API_TOKEN=
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:43171
# Вход через GitHub отключён. Локальный вход — только для разработки: 0.
DISABLE_LOCAL_LOGIN=1
# Dedicated Wiki login bot. Do not enable polling for a shared bot token.
VK_LOGIN_BOT_POLL=0
VK_BOT_AUTH_TOKEN=
VK_API_BASE=
PORTAL_EMAIL_DOMAIN=
VK_BOT_AUTH_NAME=
VK_BOT_AUTH_ID=
# Optional email login: Mail.ru sender and app password (not normal password).
EMAIL_FROM=
EMAIL_CRED_KEY=
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SSL_TLS=true
# IMAP получает почту; для отправки ключей эти параметры не используются.
IMAP_URL=imap.mail.ru
IMAP_PORT=993
IMAP_SSL_TLS=true
# Optional feedback issue publication; token stays server-side (Issues write + repository write for native attachments; PAT/OAuth, not installation token).
BUG_REPORT_GITHUB_REPOSITORY=
BUG_REPORT_GITHUB_TOKEN=
# Predefined Target configurations (docs/contracts/source-target-connections.md).
# Non-secret values only; ELMA tokens stay on the operator-bridge machine. PROD has none.
# DEV: shared business environment, read-only (health, inspect, export). Bridge: elma-dev bridge --target=main-dev
WIKI_TARGET_DEV_NAME=DEV
WIKI_TARGET_DEV_URL=https://dev.example.invalid
WIKI_TARGET_DEV_BRIDGE_TARGET=main-dev
WIKI_TARGET_DEV_OPERATIONS=health,inspect,export
# DEV2: owner's technical environment. Bridge: elma-dev bridge --target=dev2 (legacy target "dev" is refused).
WIKI_TARGET_DEV2_NAME=DEV2
WIKI_TARGET_DEV2_URL=https://dev2.example.invalid
WIKI_TARGET_DEV2_BRIDGE_TARGET=dev2
WIKI_TARGET_DEV2_OPERATIONS=health,inspect,export,readBack,deploy
# SHA-256 of owner-designated candidates only (comma list); empty = DEV2 deploy refused.
WIKI_TARGET_DEV2_DEPLOY_CANDIDATES=
# `file` reads designations from the operator record <data root>/operator/dev2-designations.json at every
# check instead (deploy/README.md); the list above must then stay empty. Empty = the list above.
WIKI_TARGET_DEV2_DESIGNATIONS=
# Hosts refused as Target regardless of name (for example the PROD host).
PROTECTED_TARGET_HOSTS=
# Optional native build over a dedicated operator bridge (docs/contracts/native-materialization.md).
# Non-secret values only: bridge UUID, its owning user ID and the pinned 40-hex worker revision. The bridge
# token stays on the worker machine. Empty = composer build unavailable (native-materialization-unconfigured).
WIKI_NATIVE_MATERIALIZATION_BRIDGE_ID=
WIKI_NATIVE_MATERIALIZATION_BRIDGE_OWNER=
WIKI_NATIVE_MATERIALIZATION_REVISION=
WIKI_NATIVE_MATERIALIZATION_TIMEOUT_MS=
WIKI_NATIVE_MATERIALIZATION_MAX_OUTPUT_BYTES=
## Local CT production updater (private .env only; never copied into the image)
PROD_IP=
PROD_USER=
# SSH private key file kept OUTSIDE this repository (key held in Infisical or the password manager).
# Or load the key into ssh-agent and set PROD_SSH_AGENT=1 instead.
PROD_SSH_KEY_FILE=
# PROD_SSH_AGENT=1
PROD_URL=
# Deprecated password fallback, allowed only until 2026-11-30 (engineering-platform EP-031).
# Remove it once key login works; it is ignored whenever a key or the agent is configured.
# PROD_PASS=
# Optional Python executable; requires Paramiko. SSH pin: .local/prod-known-hosts
# PROD_PYTHON=python
