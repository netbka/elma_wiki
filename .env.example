PORT=43171
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:43171
# Вход через GitHub отключён. Локальный вход — только для разработки: 0.
DISABLE_LOCAL_LOGIN=1
# Existing SvoiBot login bot: private values from SudSvoiBot; no second poller.
VK_BOT_AUTH_TOKEN=
VK_API_BASE=
PORTAL_EMAIL_DOMAIN=
VK_BOT_AUTH_NAME=
VK_BOT_AUTH_ID=
# Optional email login: Mail.ru sender and app password (not normal password).
EMAIL_FROM=
EMAIL_CRED_KEY=
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SSL_TLS=true
# IMAP получает почту; для отправки ключей эти параметры не используются.
IMAP_URL=imap.mail.ru
IMAP_PORT=993
IMAP_SSL_TLS=true
